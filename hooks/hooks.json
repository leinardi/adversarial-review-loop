{
  "description": "adversarial-review-loop review gate. Registered at plugin load so the gate exists in every Claude Code process, not only the one that invoked /adversarial-review-loop:implement. A session that never armed pays one silent, sub-second pass-through per tool call.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/arl.sh pretool",
            "timeout": 1200,
            "statusMessage": "Adversarial review gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/arl.sh confirm-commit",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/arl.sh posttool-failure",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/arl.sh gate-stop",
            "timeout": 1800,
            "statusMessage": "Adversarial review loop: end-of-turn gate"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/arl.sh intent",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/arl.sh reorient",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
