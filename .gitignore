# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini

# IntelliJ IDEA / JetBrains
.idea/*
!.idea/codeStyles/
!.idea/copyright/
!.idea/scopes/
*.iml
out/
.gradle/

# Other editors
.vscode/
*.code-workspace
*.swp
*~

# Logs
*.log

# Python
# Convenience only: Rule 3 (nothing is written inside the repository under review) is
# enforced by sys.pycache_prefix in scripts/arl-bootstrap.py, not by this file.
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local tooling / sandbox
.env
.env.*
.venv/
venv/
.cache/
.tmp/
tmp/

# Claude Code: the skills symlink (and shared settings, should they appear) are tracked; local
# settings (settings.local.json) and session state never are.
.claude/*
!.claude/settings.json
!.claude/skills
